# Copy this file to .env and fill in YOUR OWN keys. Never commit .env, never paste keys in a chat.

# Paper trading keys (alpaca.markets > Paper Trading > API keys). Used for paper orders and price data.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Live trading (real money). Leave empty unless you mean it.
# Live keys come from the live account (Alpaca > Live Trading > API keys).
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
# Live orders are refused unless this is 1. Even then, each live plan needs a code typed in your terminal.
APTRADE_ALLOW_LIVE=0

# Daily prices for research: auto | alpaca | yahoo | tiingo
# auto = Alpaca if its keys are set, else Tiingo if TIINGO_API_KEY is set, else Yahoo (no key).
APTRADE_DATA=auto
# Free key at tiingo.com (US stocks and ETFs). Optional.
TIINGO_API_KEY=

# Optional
# APTRADE_DATA_DIR=data
# APTRADE_DB=data/aptrade.db
